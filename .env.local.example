# 70MM VISUAL MEDIA — Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Duplicate this file and rename it to `.env.local`
# 2. Add your project values from your Supabase Dashboard:
#    Project Settings -> API -> Project URL & Project API Keys
# 3. NEVER commit `.env.local` or any real credentials to version control.
# ==============================================================================

# Supabase Project URL
# Example: https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Publishable Key (Recommended for modern Supabase projects)
# Note: For backward compatibility, if your project provides `NEXT_PUBLIC_SUPABASE_ANON_KEY`,
# our configuration helper will accept either variable seamlessly.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy Supabase Anonymous Key (Optional fallback if not using PUBLISHABLE_KEY)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ==============================================================================
# SERVER-ONLY CREDENTIALS (DOCUMENTATION ONLY — DO NOT SET UNLESS EXPLICITLY REQUIRED)
# ------------------------------------------------------------------------------
# The Supabase Service Role Key bypasses all Row-Level Security (RLS) policies.
# NEVER prefix it with NEXT_PUBLIC_. Never expose it to the browser client.
# It is NOT needed for Phase 3 Step 1.
# SUPABASE_SERVICE_ROLE_KEY=
# ==============================================================================
